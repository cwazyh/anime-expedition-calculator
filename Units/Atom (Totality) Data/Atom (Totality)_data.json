 "passives": [
  {
   "name": "CidPassive1",
   "display_name": "Archetype Nuclear",
   "unlock_upgrade": 0,
   "description": "All buffs applied from this passive last 15 seconds and do not stack.\nWhen this unit attacks a Basic enemy:\n- +15% Damage\nWhen this unit attacks an Elite:\n- +40% Critical Chance\nWhen this unit attacks a Boss:\n- Counts as attacking a Basic and an Elite\n- +10% Range\n- +20% Critical Damage"
  },
  {
   "name": "CidPassive2",
   "display_name": "Phantom Nuclear",
   "unlock_upgrade": 0,
   "description": "When Boss enters range:\n- That Boss receives +100% Damage Dealt for 10s\nAfter 10s have passed:\n- That Boss is dealt an instance of damage for 300% of this unit's damage\n- All enemies in range are dealt an instance of damage for 100% of this unit's damage\n\nPer-Player Cooldown: 60s"
  },
  {
   "name": "CidPassive3",
   "display_name": "Rising Nuclear",
   "unlock_upgrade": 0,
   "description": "After attacking the same enemy 3 times with basic attacks, inflict that enemy with Radiation:\n- Radiation: Deals 10% of this unit's damage in 7 ticks over 14s\n- Non-Boss enemies afflicted with Radiation will be executed at or below 5% health\n\nOn basic attack against an enemy afflicted with Radiation:\n- Increase the damage factor of existing Radiation on that enemy by +20% (Up to +100%)\nIf this unit is the source of the Radiation:\n- Refresh the duration of Radiation on that enemy"
  }
 ],
 "abilities": [
  {
   "name": "CidAbility1",
   "display_name": "Complete Nuclear",
   "unlock_upgrade": 7,
   "description": "On activation:\n- Remove any existing Radiation stacks from enemies\n- Starting at 500% of this unit's damage, each stack of Radiation removed will increase this ability's damage by +10% (Bonus Cap: 500%)\n- Charges for 8s before firing\n- This ability will hit every enemy on the map and bypass all mechanics"
  }
 ]
