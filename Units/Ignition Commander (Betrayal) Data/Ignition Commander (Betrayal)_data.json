 "passives": [
  {
   "name": "BurnsPassive1",
   "display_name": "Immovable",
   "unlock_upgrade": 0,
   "description": "Whenever an enemy is within 60% of this unit's range, they enter BurnsZone1\nEnemies within BurnsZone1:\n- Gain 1 HeatStack per second until they leave this unit's range (Capacity: 10 Stacks)\nWhenever an enemy is within 30% of this unit's range, they enter BurnsZone2\n- Enemies within BurnsZone2 are given:\n- Stun for 2 seconds\nAfter Stun expires:\n- Apply Rewind for 7 distance\n- Can only happen once per enemy\nIf the same enemy enters BurnsZone2 again:\n- Gain 2 HeatStack per second until they leave BurnsZone2\nIf Rewind takes an enemy outside this unit's range:\n- The enemy does not lose their current HeatStack"
  },
  {
   "name": "BurnsPassive2",
   "display_name": "Human Furnace",
   "unlock_upgrade": 0,
   "description": "For each HeatStack applied to an enemy, this unit deals:\n- 3% increased damage to that enemy per HeatStack\n\nWhen an enemy reaches 10 HeatStack:\n- This unit applies Fire to that enemy"
  },
  {
   "name": "BurnsPassive3",
   "display_name": "Ignition Release",
   "unlock_upgrade": 0,
   "description": "When Rewind is applied from BurnsPassive1:\n- Deal 75% damage to all enemies within BurnsZone1\n  15 second cooldown\nWhen an enemy reaches the HeatStack capacity from BurnsPassive1:\n- BurnsPassive3 deals 15% increase damage to them"
  }
 ],
 "abilities": []
