 "passives": [
  {
   "name": "ShoPassive1",
   "display_name": "Frozen Flames",
   "unlock_upgrade": 0,
   "description": "Every 30 seconds:\n- TimeStop all enemies in range for 10 seconds (Maximum 3 times per enemy)\nDuring TimeStop:\n- This unit applies Fire on attack\n- Fire deals 2% increased damage per tick (Capacity: 20%)\n- All currently applied DoT have their durations paused until TimeStop ends (Enemies can be afflicted by additional DoT during this)"
  },
  {
   "name": "ShoPassive2",
   "display_name": "Flame Bonded",
   "unlock_upgrade": 0,
   "description": "During TimeStop, enemies inflicted by this unit's Fire    \n- Spread an instance of Fire to 3 of the closest enemies\nWhen TimeStop ends, enemies which had Fire spread onto them   \n- Take damage equal to 15% of the damage dealt by this unit during TimeStop"
  },
  {
   "name": "ShoPassive3",
   "display_name": "Idle Flames",
   "unlock_upgrade": 0,
   "description": "For every enemy killed with TimeStop applied:\n- Increases TimeStop duration by 1 second\n- Gain a stack of FlameFeather (Capacity: 10)\nOn next TimeStop activation:\n- Consume all FlameFeather stacks\nFor each stack consumed, this unit’s next attack:\n- Applies an instance of Fire per consumed stack"
  }
 ],
