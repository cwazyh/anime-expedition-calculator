 "passives": [
  {
   "name": "BenimaruPassive1",
   "display_name": "Scorched Earth",
   "unlock_upgrade": 0,
   "description": "If an enemy is within this unit's range:\n- Gain 1 Scorched stack every 3 seconds (Capacity : 10)\nEnemies afflicted with Scorched will :\n- Take 10% increased damage from FireElement units\n- Take 20% increased damage from any FireDoT\nFor every FireElement unit placed or unique stack of FireDoT on an enemy in this unit's range:\n- Increase damage by 5% (Capacity : 25%)\n- Increase buffs from Scorched by 2% (Capacity : 10%)"
  },
  {
   "name": "BenimaruPassive2",
   "display_name": "Absolute Flames",
   "unlock_upgrade": 0,
   "description": "When an enemy has the maximum amount of Scorched stacks currently applied to them:\n- This unit's FireDoT will always critically strike on that enemy\nEach enemy with max Scorched stacks in this unit's range will:\n- Increase this unit's critical damage by 5% (Capacity: 50%)"
  },
  {
   "name": "BenimaruPassive3",
   "display_name": "Fiery Banner",
   "unlock_upgrade": 0,
   "description": "Every 10 seconds:\n- Spawn a FireBanner next to this unit (Capacity: 5)\nFireBanner will :\n- Deal 15% of this unit's current damage\n- Have a fixed SPA of 5\n- Have 75% of this unit's current range\n- Apply their own instance of FireDoT\nOnce 5 FireBanner have been spawned by this unit :\n- Spawn FireBanner from the base as summons\nFireBanner Summons will :\n- Deal 20% of this unit's current damage when passing through an enemy\n- Summons do not lose HP when passing through enemies"
  }
 ],
