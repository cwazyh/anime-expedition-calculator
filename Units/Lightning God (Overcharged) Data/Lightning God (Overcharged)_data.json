 "passives": [
  {
   "name": "EnelPassive1",
   "display_name": "Storm Charge",
   "unlock_upgrade": 0,
   "description": "This unit has EnelMeter, starting at 0.\nApplies Electricity on hit to the 10 strongest enemies.\nEvery time a Stun is activated from Electricity:\n- Increase EnelMeter by 1 (Capacity: 60)\nFor each point in the meter:\n- Increase this units Electricity damage dealt by 5%"
  },
  {
   "name": "EnelPassive2",
   "display_name": "Thundercloud",
   "unlock_upgrade": 0,
   "description": "At 25 EnelMeter stacks:\n- Summon EnelCloud within this unit's range every 10 seconds\nEnelCloud will:\n- Target a random enemy within this unit's range\n- Deal 25% of this unit's damage in 5 range\nIf EnelCloud attacks an enemy without Electricity applied:\n- Apply an additional stack of Electricity"
  },
  {
   "name": "EnelPassive3",
   "display_name": "Tempest Discharge",
   "unlock_upgrade": 0,
   "description": "At 60 EnelMeter stacks:\n- Summon a LightningStrike at this unit's position\n- Reset EnelMeter\nOn LightningStrike:\n- Deal 100% of this unit's current damage and apply Electricity to all enemies in this unit's range\n- Leave ElectricResidue on the ground that will despawn after 8 seconds\nElectricResidue will:\n- Keep Electricity permanently active on enemy until enemy has left range or it has despawned"
  },
  {
   "name": "EnelPassive4",
   "display_name": "Molten Gold",
   "unlock_upgrade": 0,
   "description": "Every 10 seconds:\n- Apply Golden to 2 enemies in range\nGolden will:\n- Stun an enemy for 3 seconds\n- Increase chain lightning hits from Electricity to an additional 2 enemies"
  }
 ],
