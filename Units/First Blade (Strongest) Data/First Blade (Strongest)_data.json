 "passives": [
  {
   "name": "UnohanaPassive1",
   "display_name": "Can't Fear Your Own Sword",
   "unlock_upgrade": 0,
   "description": "If a unit in range is afflicted with a StatusEffect or Debuff:\n- Cleanse that unit\n\nWhen this unit performs a Cleanse, for all allies in range:\n- +20% Damage for 30 seconds\n- This buff is doubled for BleachCategory units\n\nAt the same time, for this unit:\n- +25% Damage for 45 seconds\n- This buff is doubled if cleansing KenpachiEVO\n\nLocal Cooldown: 2s"
  },
  {
   "name": "UnohanaPassive2",
   "display_name": "Killers Not Dead",
   "unlock_upgrade": 0,
   "description": "If KenpachiEVO is in range, for this unit:\n- Switch to Unohana_Skill3\n- +10% Damage\n- +5% Range\n\nWhen this unit performs Unohana_Skill3, for any KenpachiEVO in range:\n- Stun that unit for 2s, bypassing any immunities\n- Enhance that unit's next attack for x15% damage dealt\n- Enable that unit's next attack to stun this unit and all enemies in range for 3s "
  },
  {
   "name": "UnohanaPassive3",
   "display_name": "Eliminate From Heaven",
   "unlock_upgrade": 0,
   "description": "If this unit is afflicted with a StatusEffect or Debuff, for the next attack:\n- Switch to Unohana_Skill3\n- +25% Damage\n\nWhen performing Unohana_Skill3, inflict Liquefy.\nLiquefy:\n- Deals 50% of this unit's damage over 2 seconds\n- On expiry: Enemy heals equal to the damage that the initial application dealt, then Liquefy is reapplied at double the damage factor"
  }
