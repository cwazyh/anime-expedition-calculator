 "passives": [
  {
   "name": "AizenPassive1",
   "display_name": "Everpresent Deception",
   "unlock_upgrade": 0,
   "description": "This unit is unsellable until Upgrade 2.\n\nIf this unit is not currently placed on the map:\n- The next placed unit is immediately replaced with this unit for free (Excludes Farm units)\n- If that unit is a BleachCategory unit, this unit places itself next to them instead (Affects each player’s units independently)\n\nFor only the first placement of this unit, pair with the closest IchigoVasto.\nWhen this unit is upgraded to a higher level than its pair:\n- Upgrade the paired unit \nIf the paired unit is removed from the map:\n- Pair with the next closest IchigoVasto"
  },
  {
   "name": "AizenPassive2",
   "display_name": "Collapse, Mirror Flower",
   "unlock_upgrade": 0,
   "description": "When this unit is inflicted with a StatusEffect or Debuff:\n- Reflect the attempt back to the source and follow-up with Aizen_Skill1 for 70% of this unit’s damage on the targeted enemy, inflicting Hypnosis\n- Hypnosis: Stays active for 10 seconds. On expiry, teleport enemy back to the original spot where they received Hypnosis\n- Enemies inflicted with Hypnosis will take 20% more damage from BleachCategory units.\n\nEvery 15s:\n- Inflict the 5 strongest enemies on the map with Hypnosis"
  },
  {
   "name": "AizenPassive3",
   "display_name": "The Ideal World",
   "unlock_upgrade": 0,
   "description": "If an enemy activates a Modifier within this unit’s range:\n- The Modifier’s effect is immediately cancelled\n- That Modifier can’t be reactivated again so long as the enemy remains within this unit’s range\n- That enemy cannot have its Modifier disabled again by this passive after it exits the range of the placement that disabled it"
  }
 ],
 "abilities": []
