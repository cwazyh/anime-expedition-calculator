  {
   "name": "GriffithSilverPassive1",
   "display_name": "The Captain",
   "unlock_upgrade": 0,
   "description": "On Placement:\n- Increase all players' units' base damage by 10% (+1% per upgrade)\n- Increase all players' Physical Archetype units' damage by 5% (+1% per upgrade)\n- Increase all players' Magical Archetype units' damage by 5% (+1% per upgrade)\n\nThe player's most equipped Archetype gains an additional 10% damage.\nBuffs from GriffithSilverPassive1 do not stack."
  },
  {
   "name": "GriffithSilverPassive2",
   "display_name": "The Falcon's Pawn",
   "unlock_upgrade": 0,
   "description": "Every 20 seconds, any unit within this unit's range will have its Range increased by 15% for 10 seconds.\n\nFor every unit buffed by both GriffithSilverPassive1 and GriffithSilverPassive2 at the same time (Capacity: 10):\n- Increase this unit's Critical Chance by 5%\n- Increase this unit's Critical Damage by 5%\n- Increase this unit's Range by 5%"
  },
  {
   "name": "GriffithSilverPassive3",
   "display_name": "War Chest",
   "unlock_upgrade": 0,
   "description": "This unit has a GriffithSilverMeter, starting at 0. (Capacity: 50)\n\nEvery 5 Kills (from any source):\n- Increase GriffithSilverMeter by 1\n\nEverytime GriffithSilverMeter increases:\n- The next enemy Kill will drop 15% more yen\n\nEvery stack of GriffithSilverMeter will:\n- Increase the dropped yen by 5%\n\nThis meter does not reset unless this unit is sold."
  }
