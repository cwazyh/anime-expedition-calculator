 "passives": [
  {
   "name": "PeronaPassive1",
   "display_name": "Mysterious Four's Princess",
   "unlock_upgrade": 0,
   "description": "When a OnePieceCategory unit attacks an enemy within this unit's range:\n- Enemies hit are inflicted with Gloom for 6s\n- Gloom: Enemies afflicted are immobilized for 3s and cannot inflict StatusEffects on units for the effect's duration\n\nOn attack against enemies afflicted with Gloom, inflict Possession\n- Possession: Upon death, revive as friendly summon for 15% of this unit's damage\n\n(Summon Cap: 20)"
  },
  {
   "name": "PeronaPassive2",
   "display_name": "Ghost Masquerade: Final Act",
   "unlock_upgrade": 0,
   "description": "Every 30s:\n- Spawn a PeronaSpecialGhost at the end of this unit's range\nWhen this PeronaSpecialGhost hits an enemy:\n- Instantly explodes in a 12 radius for 100% of this unit's damage\n\nFor every enemy that died in this unit's range while afflicted with Gloom:\n- Increase this explosion's damage dealt by +20% and its radius by +15% (Total Cap: 200% and 150%)\n- Counter resets every cycle and only counts enemies within each cycle"
  }
 ],
 "abilities": [
  {
   "name": "PeronaAbility1",
   "display_name": "Lover of Company",
   "unlock_upgrade": 6,
   "description": "On activation:\n- Select a spot within this unit's range to place a PeronaSmallGhost\n- PeronaSmallGhost has 30% of this unit's damage and 60% of this unit's range\n- Sell a PeronaSmallGhost to gain a use of this ability\n- PeronaSmallGhost counts as a OnePieceCategory unit\n\nFor the purposes of this unit's passives:\n- The range of PeronaSmallGhost is counted as part of this unit's range\n- PeronaSmallGhost counts as this unit"
  }
 ]
