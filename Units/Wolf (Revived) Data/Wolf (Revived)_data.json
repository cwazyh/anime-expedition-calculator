 "passives": [
  {
   "name": "StarrkPassive1",
   "display_name": "Rhythm of the Wolf",
   "unlock_upgrade": 0,
   "description": "This unit’s base SPA cannot go lower than 1s. This unit’s attacks ignore animation lock.\n\nOn Attack:\n- Forcibly performs StarrkEVO_Skill1\n- Increase SPA by +50% for every attack performed in the cycle\n\nOn 5th Attack:\n- Perform current attack instead of StarrkEVO_Skill1\n- Reset SPA to 0%"
  },
  {
   "name": "StarrkPassive2",
   "display_name": "Howling Tempest",
   "unlock_upgrade": 0,
   "description": "On the 5th Attack of StarrkPassive1 and for that attack only:\n- Increase AOE Size by +50% \n- Increase Damage by +100%\n- This attack has infinite range."
  },
  {
   "name": "StarrkPassive3",
   "display_name": "Soul Pack",
   "unlock_upgrade": 0,
   "description": "On the 5th Attack of each cycle performed through StarrkPassive1:\n- Spawn 2 StarrkWolves (Capacity: 3)\n\nStarrkWolf:\n- Spawns next to this unit’s position\n- Has 15% of this unit’s damage \n- Applies ManaBurn for 15% of its damage\n\nOn Attack:\n- StarrkWolf deletes itself"
  }
 ],
 "abilities": [
  {
   "name": "StarrkAbility1",
   "display_name": "Zero Machine Gun",
   "unlock_upgrade": 10,
   "description": "This unit stops attacking for 5s. After 5s:\n- Performs a modified version of StarrkEVO_Skill3 that fires constantly for 8s, dealing 65% of this unit’s damage per second\n- Inflicts ManaBurn for 100% at 6 ticks over 6 seconds\n- This ability always crits and is treated with the same effects as the 5th attack of StarrkPassive1"
  }
 ]
