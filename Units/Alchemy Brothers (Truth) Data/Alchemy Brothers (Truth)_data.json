 "passives": [
  {
   "name": "EdwardAlphonsePassive1",
   "display_name": "Understand, Deconstruct, Reconstruct",
   "unlock_upgrade": 0,
   "description": "This unit’s attacks cycle through 3 attacks\n\nUnderstand:\nOn attack:\n- Apply AlchemyMark\n  (Capacity: 3)\n- AlchemyMark will not be removed through each rotation\n\nDeconstruct:\nOn attack:\n- Grants all units in range 5% Magical damage per AlchemyMark applied\n  (Capacity: 50% Magical damage)\n  For 10 seconds\n\nReconstruct:\nOn attack:\n- Deal 120% of this unit’s current damage\n- Apply 70% Slow for 6 seconds"
  },
  {
   "name": "EdwardAlphonsePassive2",
   "display_name": "Already Understood",
   "unlock_upgrade": 0,
   "description": "Every enemy with max AlchemyMark will:\n- Skip Understand and cycle through Deconstruct and Reconstruct only\nWhen an enemy with max AlchemyMark dies:\n- Apply 2 AlchemyMark on next attack\n  5 second cooldown"
  },
  {
   "name": "EdwardAlphonsePassive3",
   "display_name": "Alchemist’s Judgement",
   "unlock_upgrade": 0,
   "description": "If the majority of your team have a damaging DoT:\n- Those units can apply 2 more stack of their DoT to the enemy\n\nIf the majority of your team have no damaging DoT:\n- This units AlchemyMark capacity is increased by 3\n- Understand from EdwardAlphonsePassive1 applies an extra AlchemyMark\n\nIf there is no majority:\n- Deconstruct’s Magical damage bonus is increased by 10%\n- Reconstruct’s Slow is increased by 10%\nExcludes all Farms"
  }
 ],
