  {
   "name": "JokerPassive1",
   "display_name": "Two-Five's Presence",
   "unlock_upgrade": 0,
   "description": "When this unit is placed:\n- All FireDoT gain 2 ticks over 2 seconds\nWhen a unit hits an enemy affected by their own FireDoT:\n- Refresh 1 of that unit's FireDoT on that enemy\n- Each FireDoT can only be refreshed once by JokerPassive1"
  },
  {
   "name": "JokerPassive2",
   "display_name": "Royal Suit",
   "unlock_upgrade": 0,
   "description": "Every attack rotates between JokerPassive2 effects:\n\nJack:\n- The enemy's FireDoT deals 15% increased damage for 5 seconds\n\nQueen:\n- Reapply 1 FireDoT on the enemy based on 60% of this unit's damage\n\nKing:\n- Apply Fire for 6 ticks over 6 seconds\n- Deal 75% of this unit's current damage\n\nJoker:\n- Apply Jack, Queen, and King\n\nQueen and King cannot create more than 1 FireDoT from this unit on the same enemy."
  },
  {
   "name": "JokerPassive3",
   "display_name": "Fifty-Two Bluff",
   "unlock_upgrade": 0,
   "description": "Every 5 attacks:\n- Apply all JokerPassive2 effects at double efficiency\n- Does not advance the JokerPassive2 rotation\nEach time this effect activates:\n- Increase this unit's Fire damage by 5%\n  (Capacity: 50%)"
  }
